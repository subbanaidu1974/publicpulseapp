# People Pulse environment. Copy to .env. Defaults shown are the in-code defaults.
# Variables marked DEV-ONLY must never be set in production.

# --- Server ---
# PORT: HTTP port. Default 3000.
PORT=3000
# NODE_ENV: "production" for built server; disables dev OTP echo.
NODE_ENV=development
# APP_URL: public URL where the app is hosted (links, callbacks).
APP_URL=""
# TRUST_PROXY: set to the number of reverse-proxy hops (e.g. 1) when behind a proxy/CDN so client IPs are real.
# TRUST_PROXY=1
# FORECAST_BLACKOUT: "1" serves the forecast blackout response (no projections) for the legally required silence period.
# FORECAST_BLACKOUT=0
# ELECTION_WINDOW_FAIL_OPEN_FORECAST: "1" lets the forecast show when the election calendar is unknown (default is fail closed). Never lifts a real blackout and never affects surveys or notifications.
# ELECTION_WINDOW_FAIL_OPEN_FORECAST=0
# ELECTION_CALENDAR_FILE: path to the election calendar JSON (default data/reference/election-calendar.json). Only verified entries inside coveredFrom..coveredThrough count.
# ELECTION_CALENDAR_FILE=data/reference/election-calendar.json
# CIVIC_ELECTION_CHOICE_SURVEYS: "1" allows election-choice Pulse Surveys (party/candidate preference) at all. Default off. Even then they run only while the election calendar says "open" for the survey's state (blackout and unknown fail closed). See docs/SURVEYS.md.
# CIVIC_ELECTION_CHOICE_SURVEYS=0

# --- Civic data stores ---
# CIVIC_DB: SQLite base path. Default data/civic.db (":memory:" under vitest). Since S-74 the civic data is FOUR separate SQLite files
# derived from it: civic.identity.db, civic.issues.db, civic.survey.db, civic.audit.db (a directory value gives <dir>/identity.db ...).
# A pre-split single file at CIVIC_DB is imported once on first start and kept as a read-only backup. See docs/STORES.md.
# CIVIC_DB=data/civic.db
# CIVIC_IDENTITY_DB / CIVIC_ISSUES_DB / CIVIC_SURVEY_DB / CIVIC_AUDIT_DB: explicit file per store (override the derived name; ":memory:" works).
# CIVIC_IDENTITY_DB=data/civic.identity.db
# CIVIC_ISSUES_DB=data/civic.issues.db
# CIVIC_SURVEY_DB=data/civic.survey.db
# CIVIC_AUDIT_DB=data/civic.audit.db
# CIVIC_MEDIA_DIR: issue photo/voice storage. Default data/civic-media.
# CIVIC_MEDIA_DIR=data/civic-media
# CIVIC_AUDIT_ANCHOR_FILE: file sink for audit-chain anchors. Default: none (no-op sink).
# CIVIC_AUDIT_ANCHOR_FILE=
# CIVIC_DEV_MASTER_KEY: DEV-ONLY master key fallback for field encryption. Use a real KMS-held key in production.
# CIVIC_DEV_MASTER_KEY=

# --- Identity / OTP limits ---
# CIVIC_EXPOSE_DEV_OTP: DEV-ONLY. "1" echoes the OTP in the API response (ignored when NODE_ENV=production). Used by E2E.
# CIVIC_EXPOSE_DEV_OTP=1
# CIVIC_EXPOSE_DEV_MAIL: DEV-ONLY. "1" echoes the officer e-mail confirmation code (dev_email_code) in the API response, outside production and only for localhost requests. Used by E2E.
# CIVIC_EXPOSE_DEV_MAIL=1
# CIVIC_OFFICER_EMAIL_SENDS: confirmation e-mails allowed per officer application (first send plus resends). Default 5.
# CIVIC_OFFICER_EMAIL_SENDS=5
# CIVIC_E2E_SEED: TEST-ONLY. "1" mounts POST /api/v1/civic/e2e/person (creates a person + session with chosen core roles) so Playwright can drive the officer/moderator consoles against the real API. Never mounted when NODE_ENV=production. playwright.config.ts sets it for its own web server; do not set it anywhere else.
# CIVIC_E2E_SEED=1
# CIVIC_DEMO_PERSONAS: DEV-ONLY. "1" mounts GET /api/v1/civic/demo/personas and POST /demo/login so you can sign in as a ready-made admin, officer, moderator, volunteer or resident without registering (docs/DEMO_PERSONAS.md). Ignored when NODE_ENV=production, and production start-up refuses it. playwright.config.ts sets it for its own web server.
# CIVIC_DEMO_PERSONAS=1
# CIVIC_EMAIL_BLOCKED_DOMAINS: extra throwaway-mail domains refused at email sign-up, comma separated (docs/EMAIL_ACCOUNTS.md).
# CIVIC_EMAIL_BLOCKED_DOMAINS=
# CIVIC_EMAIL_HOURLY_BUDGET: global email codes per hour. Default 2000.
# CIVIC_EMAIL_HOURLY_BUDGET=2000
# CIVIC_MAX_ADULTS_PER_SIM: max adults per SIM. Default 5.
# CIVIC_MAX_ADULTS_PER_SIM=5
# CIVIC_SMS_HOURLY_BUDGET: global SMS per hour. Default 2000.
# CIVIC_SMS_HOURLY_BUDGET=2000
# CIVIC_OTP_NET_LIMIT: OTP requests per network. Default 60.
# CIVIC_OTP_NET_LIMIT=60
# CIVIC_PIN_GLOBAL_CEILING: global PIN attempt ceiling. Default 20.
# CIVIC_PIN_GLOBAL_CEILING=20
# CIVIC_ATTEST_DAILY_QUOTA: attestations per day. Default 10.
# CIVIC_ATTEST_DAILY_QUOTA=10
# CIVIC_ENROL_DAILY_QUOTA: volunteer enrolments per day. Default 15.
# CIVIC_ENROL_DAILY_QUOTA=15
# CIVIC_RETENTION_DAYS: identity data retention. Default 180.
# CIVIC_RETENTION_DAYS=180

# --- Issues / media ---
# CIVIC_ME_TOO_PER_DAY: "me too" actions per day. Default 5.
# CIVIC_ME_TOO_PER_DAY=5
# CIVIC_PHOTO_MAX_BYTES: Default 2097152.
# CIVIC_PHOTO_MAX_BYTES=2097152
# CIVIC_VOICE_MAX_BYTES: Default 1048576.
# CIVIC_VOICE_MAX_BYTES=1048576
# CIVIC_MEDIA_PER_DAY: uploads per user per day. Default 20.
# CIVIC_MEDIA_PER_DAY=20
# CIVIC_MEDIA_RETENTION_DAYS: Default 180.
# CIVIC_MEDIA_RETENTION_DAYS=180
# CIVIC_SWEEP: "0" disables the background issue sweeper. Default enabled.
# CIVIC_SWEEP=1
# CIVIC_SWEEP_INTERVAL_MS: Default 600000.
# CIVIC_SWEEP_INTERVAL_MS=600000

# --- IVR / missed-call channels ---
# CIVIC_IVR_PIN_ALWAYS: "1" always require PIN on IVR. Default off.
# CIVIC_IVR_PIN_ALWAYS=0
# CIVIC_CALLBACK_BUDGET_PER_HOUR: missed-call callbacks per hour. Default 500.
# CIVIC_CALLBACK_BUDGET_PER_HOUR=500
# CIVIC_INTERNAL_BASE: internal base URL for channel callbacks. Default http://127.0.0.1:$PORT.
# CIVIC_INTERNAL_BASE=

# --- Officer e-mail (S-141): generic HTTP mail adapter. Simulator-verified only, NOT run against any real vendor (see docs/PROVIDERS.md 2b) ---
# CIVIC_MAIL_URL: transactional mail API endpoint (https required in production). Installs GenericHttpMailProvider when set.
# CIVIC_MAIL_URL=
# CIVIC_MAIL_AUTH_HEADER: header name that carries the credential. Default Authorization.
# CIVIC_MAIL_AUTH_HEADER=Authorization
# CIVIC_MAIL_AUTH_VALUE: header value (secret), e.g. "Bearer <token>". Required with CIVIC_MAIL_URL.
# CIVIC_MAIL_AUTH_VALUE=
# CIVIC_MAIL_FROM: sender address; its domain needs SPF/DKIM set up at the vendor.
# CIVIC_MAIL_FROM=
# CIVIC_MAIL_FORMAT: json (default) or form.
# CIVIC_MAIL_FORMAT=json
# CIVIC_MAIL_REQUEST_FIELDS: JSON map of request field names (to, from, subject, text, idempotencyKey) to the vendor field names.
# CIVIC_MAIL_REQUEST_FIELDS=
# CIVIC_MAIL_STATIC_FIELDS: JSON of constant extra request fields.
# CIVIC_MAIL_STATIC_FIELDS=
# CIVIC_MAIL_TIMEOUT_MS: deadline for the single send attempt. Default 5000.
# CIVIC_MAIL_TIMEOUT_MS=5000

# --- Email / OTP delivery (optional) ---
# WEB3FORMS_ACCESS_KEY: free alternative to route OTPs to observer inboxes.
WEB3FORMS_ACCESS_KEY=""
# SMTP_*: SMTP delivery for OTP emails.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM: e.g. "Pulse Survey" <otp@yourdomain.com>
SMTP_FROM=""
# SMTP_SECURE: "true" for SSL/TLS (port 465).
SMTP_SECURE=""

# --- Production guards and demo data ---
# CIVIC_ENV: "production" marks the process as production without NODE_ENV (same startup guards apply).
# CIVIC_ENV=production
# CIVIC_ALLOW_DEMO: "1" lets a production start run on demo-provenance data in data/generated (staging only).
# CIVIC_ALLOW_DEMO=0
# CIVIC_GENERATED_DIR: where the generated datasets live. Default data/generated.
# CIVIC_GENERATED_DIR=data/generated
# SERVE_BUILT: "1" serves dist/ (no Vite) even when NODE_ENV is not production. Used by e2e/ops.spec.ts for a bundle smoke test.
# SERVE_BUILT=0

# --- HTTP hardening ---
# CORS_ORIGINS: comma-separated allowlist of cross-origin callers. Default none (same-origin only).
# CORS_ORIGINS=
# RATE_LIMIT_BURST: per-IP token bucket burst for /api/v1. Default 120.
# RATE_LIMIT_BURST=120
# RATE_LIMIT_PER_SEC: per-IP refill rate for /api/v1. Default 20.
# RATE_LIMIT_PER_SEC=20

# --- Observability (S-67) ---
# LOG_LEVEL: debug | info | warn | error. Default info. Logs are JSON lines with a request id; phone/OTP/PIN/token values are redacted.
# LOG_LEVEL=info
# METRICS_TOKEN: when set, GET /metrics requires "Authorization: Bearer <token>". When unset, /metrics answers loopback connections only.
# METRICS_TOKEN=

# --- Jobs and migrations ---
# CIVIC_JOBS: "0" disables the job scheduler (retention, erasure, anchoring, chain verification). Default enabled.
# CIVIC_JOBS=1
# CIVIC_ALLOW_DRIFT: "1" lets the server start although an applied migration's SQL changed (S-72). Emergency use only; never leave set.
# CIVIC_ALLOW_DRIFT=0
# CIVIC_PREMIGRATE_BACKUP: "0" disables the automatic copy taken before pending migrations run. Default enabled.
# CIVIC_PREMIGRATE_BACKUP=1

# --- Backups (S-68) ---
# CIVIC_BACKUP_KEY: 32-byte AES-256-GCM key as 64 hex chars or base64 (openssl rand -hex 32). REQUIRED in production. Escrow it (docs/RUNBOOK.md).
# CIVIC_BACKUP_KEY=
# CIVIC_BACKUP_DIR: where scripts/backup.ts writes. Default data/backups.
# CIVIC_BACKUP_DIR=data/backups
# CIVIC_BACKUP_KEEP: encrypted backups to keep (rotation). Default 14.
# CIVIC_BACKUP_KEEP=14

# --- IVR / missed-call webhook authentication ---
# CIVIC_IVR_WEBHOOK_SECRET: shared secret that signs/authenticates telephony-provider webhooks. Required in production.
# CIVIC_IVR_WEBHOOK_SECRET=
# CIVIC_IVR_ALLOWED_IPS: comma-separated provider IPs allowed to call the webhooks.
# CIVIC_IVR_ALLOWED_IPS=

# --- Data pipeline (npm run pipeline:*) ---
# TCPD_CSV_URL: override the TCPD election CSV source URL.
# TCPD_CSV_URL=
# TCPD_ELECTION_TYPE: election type filter for the TCPD import (e.g. AE, GE).
# TCPD_ELECTION_TYPE=
# BOUNDARIES_AP_URL: override the Andhra Pradesh boundary source URL.
# BOUNDARIES_AP_URL=
# BOUNDARIES_TG_URL: override the Telangana boundary source URL.
# BOUNDARIES_TG_URL=
# DATA_GOV_IN_API_KEY: data.gov.in API key for the census fetch (never commit a real key).
# DATA_GOV_IN_API_KEY=
# DATA_GOV_IN_RESOURCE_ID: data.gov.in resource id for the census dataset.
# DATA_GOV_IN_RESOURCE_ID=
# CENSUS_RAW_DIR: directory of manually downloaded census files read by pipeline:census. Default data/raw/census.
# CENSUS_RAW_DIR=data/raw/census

# --- Dev tooling ---
# DISABLE_HMR: "true" turns off Vite HMR (used by some hosted preview environments).
# DISABLE_HMR=false

# --- People pages (server/people-api.ts) ---
# PEOPLE_BLACKOUT: "1" hides photos and leader lists and shows a neutral notice (election-period neutrality). Default off.
# PEOPLE_BLACKOUT=0
# PEOPLE_REQUEST_BURST: max correction/takedown requests per address per 10 minutes (default 3 in production, 30 otherwise).
# PEOPLE_REQUEST_BURST=3
# PEOPLE_SLA_DAYS: days within which a correction/takedown request is reviewed. Default 7.
# PEOPLE_SLA_DAYS=7

# --- Civic hardening, issues, media and admin (Wave 4) ---
# CIVIC_ANCHOR_URL / CIVIC_ANCHOR_SECRET: HTTP witness for the audit-chain head (POSTed with an HMAC signature). Unset = local file anchor only.
# CIVIC_ANCHOR_URL=
# CIVIC_ANCHOR_SECRET=
# CIVIC_EDGE_SECRET: shared secret the trusted edge sends in X-Civic-Edge; CIVIC_TRUSTED_EDGE_IPS: comma list of edge addresses.
# CIVIC_EDGE_SECRET=
# CIVIC_TRUSTED_EDGE_IPS=
# CIVIC_UNVERIFIED_CAP_FACTOR: weight applied to caps for unattested clients (default 1).
# CIVIC_UNVERIFIED_CAP_FACTOR=1
# CIVIC_EXPORT_MAX_ROWS (default 10000) / CIVIC_EXPORT_PER_HOUR (default 20): open-data export limits.
# CIVIC_EXPORT_MAX_ROWS=10000
# CIVIC_EXPORT_PER_HOUR=20
# CIVIC_GPS_EXACT_DAYS: days the exact (encrypted) GPS point is kept (default 30).
# CIVIC_GPS_EXACT_DAYS=30
# CIVIC_INVITE_DAILY_CAP (10), CIVIC_INVITE_TARGET_DAILY_CAP (3), CIVIC_INVITE_COOLDOWN_DAYS (7), CIVIC_MAX_DEPENDENTS (8): household abuse caps.
# CIVIC_INVITE_DAILY_CAP=10
# CIVIC_INVITE_TARGET_DAILY_CAP=3
# CIVIC_INVITE_COOLDOWN_DAYS=7
# CIVIC_MAX_DEPENDENTS=8
# CIVIC_IVR_CALL_TTL_MS: IVR call state lifetime (default 900000). CIVIC_IVR_RECORDING_HOSTS: comma list of allowed aggregator recording hosts.
# CIVIC_IVR_CALL_TTL_MS=900000
# CIVIC_IVR_RECORDING_HOSTS=
# CIVIC_IVR_DEFAULT_DIALECT: dialect used when the telephony aggregator sends none: standard (default), coastal, rayalaseema or telangana. Only REVIEWED recordings are played; anything else falls back to the standard key.
# CIVIC_IVR_DEFAULT_DIALECT=standard
# CIVIC_IVR_TTS_FALLBACK: 1 renders prompts with no reviewed recording as <Say language="te-IN"> text-to-speech instead of <Play> of the placeholder file. Default off.
# CIVIC_IVR_TTS_FALLBACK=0
# CIVIC_LEXICON_FILE: moderation lexicon path; CIVIC_LEXICON_ADD_APPROVALS (1) / CIVIC_LEXICON_RETIRE_APPROVALS (2): approvals needed.
# CIVIC_LEXICON_FILE=data/civic/moderation-lexicon.json
# CIVIC_LEXICON_ADD_APPROVALS=1
# CIVIC_LEXICON_RETIRE_APPROVALS=2
# CIVIC_LOGIN_SOURCE_LIMIT (per person+source) / CIVIC_LOGIN_PHONE_CEILING (per person across sources): login attempt limits.
# CIVIC_LOGIN_SOURCE_LIMIT=5
# CIVIC_LOGIN_PHONE_CEILING=20
# CIVIC_MEDIA_KEY: overrides the key provider for media at rest (production should use the key provider). CIVIC_MEDIA_SCANNER=none disables the heuristic scanner (dev only).
# CIVIC_MEDIA_KEY=
# CIVIC_MEDIA_SCANNER=heuristic
# CIVIC_PHOTO_MAX_DIM (6000) / CIVIC_PHOTO_MAX_PIXELS (25000000): photo dimension caps.
# CIVIC_PHOTO_MAX_DIM=6000
# CIVIC_PHOTO_MAX_PIXELS=25000000
# CIVIC_RECHECK_FRACTION: share of volunteer enrolments sampled for re-check (default 0.1).
# CIVIC_RECHECK_FRACTION=0.1
# CIVIC_RECHECK_DUE_DAYS: days an independent volunteer has to answer a re-check task before it expires (default 14). The sampler job runs every 6 hours (S-159).
# CIVIC_RECHECK_DUE_DAYS=14
# CIVIC_RISK_CAP_FACTOR: multiplier (0 to 1) on the per-phone OTP cap for numbers the intelligence vendor rates medium or high risk (default 0.67; 1 = no difference) (S-162).
# CIVIC_RISK_CAP_FACTOR=0.67
# CIVIC_SCRYPT_CONCURRENCY: parallel PIN hashes (default 4).
# CIVIC_SCRYPT_CONCURRENCY=4
# CIVIC_SESSION_TTL_DAYS (7) / CIVIC_SESSION_MAX_DAYS (30): sliding session lifetime and hard cap.
# CIVIC_SESSION_TTL_DAYS=7
# CIVIC_SESSION_MAX_DAYS=30
# CIVIC_TOTP_WINDOW: accepted TOTP step drift (default 1).
# CIVIC_TOTP_WINDOW=1
# TEST_WORKER_INDEX: set by the test runner only.
# TEST_WORKER_INDEX=

# CIVIC_OTP_IP_LIMIT: OTP requests allowed per IP per 10 minutes (default 10). Tests raise it; keep the default in production.
# CIVIC_OTP_IP_LIMIT=10

# E2E_BUILT: "1" runs Playwright against the production bundle (npm run build first); used for the offline-shell and 2G specs.
# E2E_BUILT=0

# --- Providers (S-62 number intelligence, S-63 SMS, S-64 KMS/HSM). Neutral HTTP/JSON adapters; see docs/PROVIDERS.md. ---
# A vendor-specific adapter module can instead call setKeyProvider / setSmsProvider / setNumberIntelligence itself; those win over these URLs.
# CIVIC_KMS_URL: base URL of a KMS speaking the neutral wrap/unwrap/hmac shape (https in production). Installs RemoteKmsKeyProvider.
# CIVIC_KMS_URL=
# CIVIC_KMS_SECRET: HMAC secret that signs requests to the KMS. Required with CIVIC_KMS_URL.
# CIVIC_KMS_SECRET=
# CIVIC_AWS_KMS_KEY_ID: AWS KMS key id / ARN / alias that wraps the per-purpose data keys. Installs AwsKmsKeyProvider (do not also set CIVIC_KMS_URL). NOT yet run against real AWS; see docs/PROVIDERS.md.
# CIVIC_AWS_KMS_KEY_ID=
# CIVIC_AWS_KMS_REGION: AWS region of the key (falls back to AWS_REGION). Required with CIVIC_AWS_KMS_KEY_ID.
# CIVIC_AWS_KMS_REGION=
# CIVIC_AWS_KMS_ENDPOINT: optional endpoint override (VPC / FIPS endpoint); must be https in production. Default https://kms.<region>.amazonaws.com
# CIVIC_AWS_KMS_ENDPOINT=
# AWS_REGION: standard AWS region variable, used when CIVIC_AWS_KMS_REGION is unset.
# AWS_REGION=
# AWS_ACCESS_KEY_ID: AWS credentials for the KMS caller (static credentials only; keep in the secret store, grant only kms:Encrypt and kms:Decrypt on the one key).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY: secret for AWS_ACCESS_KEY_ID.
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN: only for temporary credentials (they must be refreshed by restarting; no automatic credential chain is implemented).
# AWS_SESSION_TOKEN=
# CIVIC_KMS_KEK_ID: id of the KMS key that wraps the per-purpose data keys. Required with CIVIC_KMS_URL.
# CIVIC_KMS_KEK_ID=
# CIVIC_KMS_RECOVERY_KEY_ID: KEK that dual-control break-glass bundles are wrapped under. Only needed to use break-glass export.
# CIVIC_KMS_RECOVERY_KEY_ID=
# CIVIC_KMS_TIMEOUT_MS: per-call KMS deadline. Default 3000.
# CIVIC_KMS_TIMEOUT_MS=3000
# CIVIC_KMS_CACHE_TTL_MS: how long an unwrapped data key may be used without a successful refresh before every operation fails closed. Default 900000 (15 min). 0 = never expire (not recommended).
# CIVIC_KMS_CACHE_TTL_MS=900000
# CIVIC_SMS_URL: neutral SMS submit endpoint (https in production). Installs HttpSmsProvider.
# CIVIC_SMS_URL=
# CIVIC_SMS_SECRET: HMAC secret that signs submissions to CIVIC_SMS_URL. Required with it.
# CIVIC_SMS_SECRET=
# CIVIC_SMS_RECEIPT_SECRET: HMAC secret that authenticates delivery receipts POSTed to /api/v1/civic/channels/sms-receipt. Required in production with CIVIC_SMS_URL.
# CIVIC_SMS_RECEIPT_SECRET=
# CIVIC_SMS_RECEIPT_URL: public URL of the receipt endpoint, passed to the vendor as callback_url.
# CIVIC_SMS_RECEIPT_URL=
# --- Generic configurable SMS gateway adapter (S-63). NOT run against any real gateway; confirm every mapping below with the chosen vendor documentation. ---
# CIVIC_SMSGW_URL: gateway submit endpoint (https in production). Installs GenericHttpSmsProvider when CIVIC_SMS_URL is not set.
# CIVIC_SMSGW_URL=
# CIVIC_SMSGW_AUTH_HEADER: header name that carries the credential. Default Authorization.
# CIVIC_SMSGW_AUTH_HEADER=Authorization
# CIVIC_SMSGW_AUTH_VALUE: header value (secret), e.g. "Bearer <token>". Required with CIVIC_SMSGW_URL.
# CIVIC_SMSGW_AUTH_VALUE=
# CIVIC_SMSGW_ENTITY_ID: DLT principal entity id, sent when the request field map names entityId.
# CIVIC_SMSGW_ENTITY_ID=
# CIVIC_SMSGW_FORMAT: json (default) or form.
# CIVIC_SMSGW_FORMAT=json
# CIVIC_SMSGW_REQUEST_FIELDS: JSON map of request field names (to, text, sender, templateId, entityId, reference, callbackUrl).
# CIVIC_SMSGW_REQUEST_FIELDS=
# CIVIC_SMSGW_STATIC_FIELDS: JSON of constant extra request fields (route, unicode flag...).
# CIVIC_SMSGW_STATIC_FIELDS=
# CIVIC_SMSGW_RESPONSE_PATHS: JSON dot paths into the submit answer (id, status, cost, currency).
# CIVIC_SMSGW_RESPONSE_PATHS=
# CIVIC_SMSGW_RECEIPT_PATHS: JSON describing the delivery-receipt body (list, id, status, error, at).
# CIVIC_SMSGW_RECEIPT_PATHS=
# CIVIC_SMSGW_RECEIPT_SECRET: HMAC-SHA256 secret over the raw receipt body (hex in CIVIC_SMSGW_RECEIPT_SIG_HEADER). Alternative: CIVIC_SMSGW_RECEIPT_TOKEN.
# CIVIC_SMSGW_RECEIPT_SECRET=
# CIVIC_SMSGW_RECEIPT_SIG_HEADER: header carrying the receipt signature. Default x-signature.
# CIVIC_SMSGW_RECEIPT_SIG_HEADER=x-signature
# CIVIC_SMSGW_RECEIPT_TOKEN: static token the gateway sends with each receipt (constant-time compare).
# CIVIC_SMSGW_RECEIPT_TOKEN=
# CIVIC_SMSGW_RECEIPT_TOKEN_HEADER: header carrying that token. Default x-receipt-token.
# CIVIC_SMSGW_RECEIPT_TOKEN_HEADER=x-receipt-token
# CIVIC_SMSGW_TIMEOUT_MS: per-attempt deadline for the generic gateway. Default 4000.
# CIVIC_SMSGW_TIMEOUT_MS=4000
# CIVIC_SMS_TEMPLATES_FILE: JSON array of DLT templates ({id, dltTemplateId, body, language, category, senderId?}) merged over the built-in ones. Production refuses any text that is not a template carrying a dltTemplateId.
# CIVIC_SMS_TEMPLATES_FILE=
# CIVIC_SMS_SENDER_ID: default DLT sender id (header) for templates that do not set one.
# CIVIC_SMS_SENDER_ID=
# CIVIC_SMS_TIMEOUT_MS: per-attempt vendor deadline; a send never blocks a request longer than this. Default 4000.
# CIVIC_SMS_TIMEOUT_MS=4000
# CIVIC_SMS_MAX_ATTEMPTS: attempts before a message is dead-lettered. Default 5.
# CIVIC_SMS_MAX_ATTEMPTS=5
# CIVIC_SMS_UNIT_COST: price per SMS segment in CIVIC_SMS_CURRENCY. Unset = unknown: costs are recorded as 0 and flagged, never silently free.
# CIVIC_SMS_UNIT_COST=
# CIVIC_SMS_CURRENCY: currency of CIVIC_SMS_UNIT_COST. Default INR.
# CIVIC_SMS_CURRENCY=INR
# CIVIC_SMS_DAILY_COST_CAP: known spend per rolling 24 h above which further sends are held (state budget_exhausted). Unset = no cap.
# CIVIC_SMS_DAILY_COST_CAP=
# CIVIC_NUMINTEL_URL: neutral number-intelligence endpoint (https in production; the clear number is sent). Installs HttpNumberIntel.
# CIVIC_NUMINTEL_URL=
# CIVIC_NUMINTEL_SECRET: HMAC secret that signs lookups. Required with CIVIC_NUMINTEL_URL.
# CIVIC_NUMINTEL_SECRET=
# CIVIC_NUMINTEL_API_KEY: with CIVIC_NUMINTEL_URL selects the GENERIC API-key HTTP adapter instead of the neutral signed shape (then CIVIC_NUMINTEL_SECRET is not needed). The key goes in the header named by the mapping (default x-api-key).
# CIVIC_NUMINTEL_API_KEY=
# CIVIC_NUMINTEL_MAPPING_FILE: JSON file with the vendor request/response mapping for the generic adapter (see docs/PROVIDERS.md). Must be confirmed against the vendor's own documentation.
# CIVIC_NUMINTEL_MAPPING_FILE=
# CIVIC_NUMINTEL_TIMEOUT_MS: lookup deadline; on timeout the result is "unknown, reduced trust" and sign-up continues. Default 2000.
# CIVIC_NUMINTEL_TIMEOUT_MS=2000
# CIVIC_NUMINTEL_CACHE_TTL_MS: how long a verdict is cached by phone hash. Default 86400000 (24 h).
# CIVIC_NUMINTEL_CACHE_TTL_MS=86400000
# CIVIC_ALLOW_NO_ATTESTATION: "1" lets a production start run on the dev attestation verifier (device ids then only come from the trusted edge). Explicit risk acceptance.
# CIVIC_ALLOW_NO_ATTESTATION=0

# --- Published survey figures (S-32, S-33; docs/SURVEYS.md, docs/SURVEY_METHOD.md) ---
# SURVEY_MIN_CELL: minimum cell size k; smaller cells are hidden and rolled up into the parent (with complementary suppression). Default 30.
# SURVEY_MIN_CELL=30
# SURVEY_MIN_OPTION_COUNT: an answer option with fewer responses than this in a cell is merged into "other" for that cell. Default 5.
# SURVEY_MIN_OPTION_COUNT=5
# SURVEY_MIN_OPTION_SHARE: ...or with a smaller share than this (0 disables). Default 0.02.
# SURVEY_MIN_OPTION_SHARE=0.02
# SURVEY_ROUND_TO: published counts are rounded to a multiple of this. Default 5.
# SURVEY_ROUND_TO=5
# SURVEY_PUBLISH_DELAY_HOURS: figures appear only this long after a survey closes (never live or partial). Default 24.
# SURVEY_PUBLISH_DELAY_HOURS=24
# SURVEY_PUBLISH_WINDOW_HOUR_IST: optional fixed daily publishing hour (0-23, India time); publication then waits for the next window. Unset = publish as soon as the delay passes.
# SURVEY_PUBLISH_WINDOW_HOUR_IST=
# SURVEY_RESULTS_PER_CALLER_DAY: figure requests per survey per caller (hashed IP bucket, and the person when authenticated) per UTC day. Default 120.
# SURVEY_RESULTS_PER_CALLER_DAY=120
# SURVEY_RESULTS_GLOBAL_DAY: figure requests per survey per UTC day across all callers. Default 50000.
# SURVEY_RESULTS_GLOBAL_DAY=50000
# SURVEY_MARGINALS_FILE: post-stratification reference figures (source, asOf, provenance per figure). Default data/reference/survey-marginals.json.
# SURVEY_MARGINALS_FILE=
# SURVEY_QUALITY_MIN_CATEGORY_N: responses a reference category needs to count as covered in the quality score. Default 10.
# SURVEY_QUALITY_MIN_CATEGORY_N=10
# SURVEY_CODE_VERSION: build/commit id appended to the method version string in every published payload. Default "dev".
# SURVEY_CODE_VERSION=

# --- Anonymous survey credential and responses (S-29, S-30, S-31; docs/SURVEYS.md) ---
# CIVIC_SURVEY_MIN_ACCOUNT_DAYS: account age (from sign-up) before a person may answer a Pulse Survey. Default 14.
# CIVIC_SURVEY_MIN_ACCOUNT_DAYS=14
# CIVIC_SURVEY_IDEM_MINUTES: retry window in which the SAME credential request (same nonce and blinded value) returns the SAME blind signature. Default 10.
# CIVIC_SURVEY_IDEM_MINUTES=10
# CIVIC_SURVEY_KEY_BITS: RSA modulus size of per-survey signing keys; 2048 minimum (lower values are ignored). Default 2048.
# CIVIC_SURVEY_KEY_BITS=2048
# CIVIC_SURVEY_FLUSH_MS: base interval of the shuffled response batch writer (actual wait is 0.5x to 1.5x, random). Default 60000.
# CIVIC_SURVEY_FLUSH_MS=60000
# CIVIC_SURVEY_FLUSH_ITEMS: flush a shuffled batch as soon as this many responses wait. Default 25.
# CIVIC_SURVEY_FLUSH_ITEMS=25
# CIVIC_SURVEY_RESPOND_PER_MIN: per-network-prefix limit on the unauthenticated respond endpoint; kept in memory only, never logged or stored. Default 30.
# CIVIC_SURVEY_RESPOND_PER_MIN=30

# --- Count day signed snapshots (S-41; docs/COUNT_DAY.md) ---
# COUNTDAY_DIR: static snapshot tree written by scripts/countday-ingest.ts and served at /api/v1/countday. Default data/generated/countday.
# COUNTDAY_DIR=
# COUNTDAY_STALE_MINUTES: minutes without a source update before the latest snapshot is labelled stale (visible banner EN/TE). Default 10.
# COUNTDAY_STALE_MINUTES=10
# COUNT_DAY_ACTIVE: 1 while a count-day feed is active: the forecast route returns hidden with a notice (no projection during the count).
# COUNT_DAY_ACTIVE=
# COUNTDAY_SOURCE: ingest source, fixture (SYNTHETIC) | file-drop | http. No default.
# COUNTDAY_SOURCE=
# COUNTDAY_FILE_DROP_DIR: directory (or file) where an operator places a licensed/official feed in the neutral schema.
# COUNTDAY_FILE_DROP_DIR=
# COUNTDAY_HTTP_URL: feed URL for the HTTP source. NO default; only a feed you are licensed to use. https required (loopback http allowed).
# COUNTDAY_HTTP_URL=
# COUNTDAY_HTTP_TOKEN: optional bearer token sent to COUNTDAY_HTTP_URL.
# COUNTDAY_HTTP_TOKEN=
# COUNTDAY_FALLBACK: tcpd enables the delayed TCPD/in-rolls fallback (post-count only) when the live source is down.
# COUNTDAY_FALLBACK=
# COUNTDAY_FALLBACK_NOT_BEFORE: ISO time before which the delayed fallback refuses to publish (end of counting).
# COUNTDAY_FALLBACK_NOT_BEFORE=
# COUNTDAY_ALLOW_SYNTHETIC: 1 lets production ingest or serve SYNTHETIC snapshots (staging only). Default refused in production.
# COUNTDAY_ALLOW_SYNTHETIC=
# COUNTDAY_SOURCES_FILE: outbound Form 20 / affidavit link register. Default data/reference/countday-sources.json.
# COUNTDAY_SOURCES_FILE=

# --- Count-day degraded mode and OTP queue (S-46; docs/DEGRADED_MODE.md) ---
# CIVIC_DEGRADED: 1 forces degraded (read-only) mode: non-essential routes answer 503 + Retry-After. Read live. Default off.
# CIVIC_DEGRADED=
# CIVIC_DEGRADED_RETRY_SECONDS: Retry-After on shed answers. Default 60.
# CIVIC_DEGRADED_MIN_HOLD_SECONDS: stay degraded this long after the cause ends (anti-flap). Default 60.
# CIVIC_DEGRADED_SMS_HOLD_SECONDS: how long a refused SMS budget keeps the mode on. Default 300.
# CIVIC_DEGRADED_ERROR_RATE: 5xx share (0 to 1) over 60 s that turns the mode on (needs 40+ responses). Default 0.25.
# CIVIC_DEGRADED_QUEUE_DEPTH: OTP queue depth that turns the mode on. Default 100.
# CIVIC_OTP_QUEUE_MAX: bounded OTP send queue size. Default 200.
# CIVIC_OTP_SLOT_SECONDS: smoothing slot length. Default 60.
# CIVIC_OTP_SMOOTH_FACTOR: per-slot allowance as a multiple of budget/slots-per-hour. Default 2.
# CIVIC_OTP_MIN_BURST: smallest per-slot allowance. Default 20.
# CIVIC_OTP_MAX_WAIT_SECONDS: longest estimated queue wait accepted (else 503). Default 120.

# --- Bill consultations (S-35, S-36; docs/CONSULTATIONS.md; policy file data/civic/consultation-policy.json) ---
# Eligibility, k-suppression (SURVEY_MIN_CELL), rounding and the publish delay are shared with Pulse Surveys (CIVIC_SURVEY_MIN_ACCOUNT_DAYS, SURVEY_*).
# CONSULT_FEEDBACK_PER_MIN_PERSON: feedback submissions per person per consultation per minute. Default 60.
# CONSULT_FEEDBACK_PER_MIN_PERSON=60
# CONSULT_FEEDBACK_PER_MIN_NET: feedback submissions per network prefix (IPv4 /24, IPv6 /48) per consultation per minute. Default 120.
# CONSULT_FEEDBACK_PER_MIN_NET=120
# CONSULT_BURST_PER_MIN: accepted feedback per minute per consultation at or above which the minute is flagged in the closing report. Default 100.
# CONSULT_BURST_PER_MIN=100
# CONSULT_DUP_THRESHOLD: shingle Jaccard similarity (0.3-1) at or above which two comments are near-duplicates. Default 0.8.
# CONSULT_DUP_THRESHOLD=0.8
# CONSULT_CLUSTER_FLAG_MIN: a near-duplicate cluster of at least this many comments is flagged. Default 10.
# CONSULT_CLUSTER_FLAG_MIN=10
# CONSULT_REPORT_DUE_DAYS: days after closes_at by which the closing report must be published; later it is flagged overdue in the public registry. Default 30.
# CONSULT_REPORT_DUE_DAYS=30
# CONSULT_AUDIO_DIR: where staff-uploaded consultation recordings are stored (a folder per consultation, generated file names). Default <CIVIC_MEDIA_DIR>/consultation-audio, i.e. data/civic-media/consultation-audio.
# CONSULT_AUDIO_DIR=data/civic-media/consultation-audio
# CONSULT_AUDIO_MAX_BYTES: largest recording accepted by POST /consultations/:id/audio/upload (at least 1024). Default 5242880 (5 MiB).
# CONSULT_AUDIO_MAX_BYTES=5242880

# --- Government notifications (server/civic/notify, docs/NOTIFICATIONS.md) ---
# NOTIFY_WEBAUTHN_RP_ID: WebAuthn relying-party id (the site's registrable domain, e.g. pulse.example.in). Required in production; defaults to localhost elsewhere.
# NOTIFY_WEBAUTHN_RP_ID=
# NOTIFY_WEBAUTHN_ORIGINS: comma-separated exact origins allowed to sign in with a security key (https://pulse.example.in). Required in production.
# NOTIFY_WEBAUTHN_ORIGINS=
# NOTIFY_WEBAUTHN_RP_NAME: display name shown by the authenticator. Default "People Pulse".
# NOTIFY_WEBAUTHN_RP_NAME=People Pulse
# NOTIFY_MCC_TEMPLATES_FILE: path to the pre-cleared MCC templates (default data/reference/mcc-templates.json; the shipped file has EXAMPLES only, none cleared).
# NOTIFY_MCC_TEMPLATES_FILE=

# --- Data refresh and freshness (docs/DATA_REFRESH.md) ---
# REFRESH_ENABLED: 1 registers the in-server staged data refresh job. Default 0: no network fetch is ever scheduled; use `npm run refresh:data` by hand.
# REFRESH_ENABLED=0
# REFRESH_INTERVAL_HOURS: period of the scheduled refresh when REFRESH_ENABLED=1. Default 24.
# REFRESH_INTERVAL_HOURS=24
# REFRESH_STEPS: comma list of pipeline steps for the refresh (lgd, boundaries, names-te, census, elections). Default lgd,boundaries,names-te; elections also needs TCPD_CSV_URL.
# REFRESH_STEPS=lgd,boundaries,names-te
# DATA_FRESHNESS_THRESHOLDS: per-dataset staleness overrides in days, e.g. geo-lgd-AP=30,elections=400. Defaults are per dataset family.
# DATA_FRESHNESS_THRESHOLDS=

# --- Verified officers and representative replies (docs/OFFICERS.md, docs/REPRESENTATIVES.md) ---
# CIVIC_OFFICER_DOMAINS: comma list of official e-mail domains that replaces data/civic/officer-domains.json (ops and tests). Empty = use the file.
# CIVIC_OFFICER_DOMAINS=
# CIVIC_OFFICER_APPLY_PER_30D: complete officer applications one person may file in 30 days. Default 3.
# CIVIC_OFFICER_APPLY_PER_30D=3
# CIVIC_OFFICER_APPLY_PER_IP_HOUR: officer application attempts per network address per hour. Default 20.
# CIVIC_OFFICER_APPLY_PER_IP_HOUR=20
# CIVIC_REP_REPLIES_PER_DAY: replies and new versions one representative may post per day. Default 10.
# CIVIC_REP_REPLIES_PER_DAY=10

# --- Assisted participation (S-49, docs/ASSISTED_PARTICIPATION.md). OFF by default. ---
# ASSISTED_ENABLED: "1" turns the feature on; anything else (default 0) makes every /assisted route answer 404 assisted_disabled.
# ASSISTED_ENABLED=0
# ASSISTED_SUNSET_DATE: REQUIRED to enable (YYYY-MM-DD, UTC). The feature switches itself off after the end of that day; renew it only after reviewing the evaluation.
# ASSISTED_SUNSET_DATE=2027-06-30
# The kill switch is not an env var: two admins with TOTP disable or re-enable it through /assisted/switch (dual control).
# ASSISTED_PAIR_DAILY_CAP: records per pair per rolling 24 hours. Default 15.   ASSISTED_VILLAGE_DAILY_CAP: per village. Default 40.
# ASSISTED_RECHECK_SAMPLE: share of records re-checked at random after a pair's first records. Default 0.2.   ASSISTED_RECHECK_NEW_PAIR_N: first N records of a new pair are all re-checked. Default 10.
# ASSISTED_RECHECK_DAYS: days allowed for a re-check. Default 7.
# ASSISTED_SUSPEND_THRESHOLD: a pair is suspended automatically when not_confirmed / (confirmed + not_confirmed) is above this. Default 0.25.   ASSISTED_SUSPEND_MIN_CHECKED: minimum checked records first. Default 5.
# ASSISTED_RATE_PER_MIN: records per assistant per minute. Default 20.   ASSISTED_RECEIPT_ATTEMPTS_PER_HOUR: receipt lookups per address per hour. Default 30.

# --- History store (docs/HISTORY_STORE.md) ---
# HISTORY_DB: path of the local history SQLite file built by `npm run history:build`. Default data/history.db (git-ignored).
# HISTORY_DB=data/history.db
# HISTORY_AUTO_RECORD: "1" makes a successful data refresh create/update the history store even if it does not exist yet; "0" disables recording. Default: record only when the file already exists.
# HISTORY_AUTO_RECORD=1

# Compliance guard (docs/NONCOMMERCIAL.md). Leave unset or 0 while SHRUG village boundaries (CC BY-NC-SA 4.0) are shipped.
# Set to 1 only if the service becomes commercial (ads, paid tiers, data sales); the licence test then fails until
# non-commercial / share-alike datasets are removed or separately licensed.
COMMERCIAL_USE=0

# BASEMAP_FILE: path of the self-hosted map background (a PMTiles file of OpenStreetMap data for AP and TG). Default data/basemap/ap-tg.pmtiles. When the file is missing the maps draw plain boundary shapes. See docs/BASEMAP.md.
# BASEMAP_FILE=data/basemap/ap-tg.pmtiles
# PHOTO_SUBMISSIONS_DIR: where photos people submit for a constituency page wait for review, never served until an admin approves (S-200). Default data/photo-submissions.
# PHOTO_SUBMISSIONS_DIR=data/photo-submissions
# PHOTO_SUBMIT_BURST: photo submissions allowed per address per 10 minutes. Default 3 in production, 30 otherwise.
# PHOTO_SUBMIT_BURST=3
# PANCHAYAT_UNITS_DIR: folder holding units-<ST>.json panchayat result files. Default data/reference/panchayat (no file there yet). Set it only for tests or to look at the sample screens: files marked as samples are accepted only when this is set (S-221).
# PANCHAYAT_UNITS_DIR=data/reference/panchayat
