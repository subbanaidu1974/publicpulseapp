# People Pulse environment. Copy to .env. Defaults shown are the in-code defaults.
# Variables marked DEV-ONLY must never be set in production.

# --- Server ---
# PORT: HTTP port. Default 3000.
PORT=3000
# NODE_ENV: "production" for built server; disables dev OTP echo.
NODE_ENV=development
# APP_URL: public URL where the app is hosted (links, callbacks).
APP_URL=""
# TRUST_PROXY: set to the number of reverse-proxy hops (e.g. 1) when behind a proxy/CDN so client IPs are real.
# TRUST_PROXY=1
# FORECAST_BLACKOUT: "1" serves the forecast blackout response (no projections) for the legally required silence period.
# FORECAST_BLACKOUT=0
# ELECTION_WINDOW_FAIL_OPEN_FORECAST: "1" lets the forecast show when the election calendar is unknown (default is fail closed). Never lifts a real blackout and never affects surveys or notifications.
# ELECTION_WINDOW_FAIL_OPEN_FORECAST=0
# ELECTION_CALENDAR_FILE: path to the election calendar JSON (default data/reference/election-calendar.json). Only verified entries inside coveredFrom..coveredThrough count.
# ELECTION_CALENDAR_FILE=data/reference/election-calendar.json

# --- Civic data stores ---
# CIVIC_DB: SQLite base path. Default data/civic.db (":memory:" under vitest). Since S-74 the civic data is FOUR separate SQLite files
# derived from it: civic.identity.db, civic.issues.db, civic.survey.db, civic.audit.db (a directory value gives <dir>/identity.db ...).
# A pre-split single file at CIVIC_DB is imported once on first start and kept as a read-only backup. See docs/STORES.md.
# CIVIC_DB=data/civic.db
# CIVIC_IDENTITY_DB / CIVIC_ISSUES_DB / CIVIC_SURVEY_DB / CIVIC_AUDIT_DB: explicit file per store (override the derived name; ":memory:" works).
# CIVIC_IDENTITY_DB=data/civic.identity.db
# CIVIC_ISSUES_DB=data/civic.issues.db
# CIVIC_SURVEY_DB=data/civic.survey.db
# CIVIC_AUDIT_DB=data/civic.audit.db
# CIVIC_MEDIA_DIR: issue photo/voice storage. Default data/civic-media.
# CIVIC_MEDIA_DIR=data/civic-media
# CIVIC_AUDIT_ANCHOR_FILE: file sink for audit-chain anchors. Default: none (no-op sink).
# CIVIC_AUDIT_ANCHOR_FILE=
# CIVIC_DEV_MASTER_KEY: DEV-ONLY master key fallback for field encryption. Use a real KMS-held key in production.
# CIVIC_DEV_MASTER_KEY=

# --- Identity / OTP limits ---
# CIVIC_EXPOSE_DEV_OTP: DEV-ONLY. "1" echoes the OTP in the API response (ignored when NODE_ENV=production). Used by E2E.
# CIVIC_EXPOSE_DEV_OTP=1
# CIVIC_E2E_SEED: TEST-ONLY. "1" mounts POST /api/v1/civic/e2e/person (creates a person + session with chosen core roles) so Playwright can drive the officer/moderator consoles against the real API. Never mounted when NODE_ENV=production. playwright.config.ts sets it for its own web server; do not set it anywhere else.
# CIVIC_E2E_SEED=1
# CIVIC_MAX_ADULTS_PER_SIM: max adults per SIM. Default 5.
# CIVIC_MAX_ADULTS_PER_SIM=5
# CIVIC_SMS_HOURLY_BUDGET: global SMS per hour. Default 2000.
# CIVIC_SMS_HOURLY_BUDGET=2000
# CIVIC_OTP_NET_LIMIT: OTP requests per network. Default 60.
# CIVIC_OTP_NET_LIMIT=60
# CIVIC_PIN_GLOBAL_CEILING: global PIN attempt ceiling. Default 20.
# CIVIC_PIN_GLOBAL_CEILING=20
# CIVIC_ATTEST_DAILY_QUOTA: attestations per day. Default 10.
# CIVIC_ATTEST_DAILY_QUOTA=10
# CIVIC_ENROL_DAILY_QUOTA: volunteer enrolments per day. Default 15.
# CIVIC_ENROL_DAILY_QUOTA=15
# CIVIC_RETENTION_DAYS: identity data retention. Default 180.
# CIVIC_RETENTION_DAYS=180

# --- Issues / media ---
# CIVIC_ME_TOO_PER_DAY: "me too" actions per day. Default 5.
# CIVIC_ME_TOO_PER_DAY=5
# CIVIC_PHOTO_MAX_BYTES: Default 2097152.
# CIVIC_PHOTO_MAX_BYTES=2097152
# CIVIC_VOICE_MAX_BYTES: Default 1048576.
# CIVIC_VOICE_MAX_BYTES=1048576
# CIVIC_MEDIA_PER_DAY: uploads per user per day. Default 20.
# CIVIC_MEDIA_PER_DAY=20
# CIVIC_MEDIA_RETENTION_DAYS: Default 180.
# CIVIC_MEDIA_RETENTION_DAYS=180
# CIVIC_SWEEP: "0" disables the background issue sweeper. Default enabled.
# CIVIC_SWEEP=1
# CIVIC_SWEEP_INTERVAL_MS: Default 600000.
# CIVIC_SWEEP_INTERVAL_MS=600000

# --- IVR / missed-call channels ---
# CIVIC_IVR_PIN_ALWAYS: "1" always require PIN on IVR. Default off.
# CIVIC_IVR_PIN_ALWAYS=0
# CIVIC_CALLBACK_BUDGET_PER_HOUR: missed-call callbacks per hour. Default 500.
# CIVIC_CALLBACK_BUDGET_PER_HOUR=500
# CIVIC_INTERNAL_BASE: internal base URL for channel callbacks. Default http://127.0.0.1:$PORT.
# CIVIC_INTERNAL_BASE=

# --- Email / OTP delivery (optional) ---
# WEB3FORMS_ACCESS_KEY: free alternative to route OTPs to observer inboxes.
WEB3FORMS_ACCESS_KEY=""
# SMTP_*: SMTP delivery for OTP emails.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM: e.g. "Pulse Survey" <otp@yourdomain.com>
SMTP_FROM=""
# SMTP_SECURE: "true" for SSL/TLS (port 465).
SMTP_SECURE=""

# --- Production guards and demo data ---
# CIVIC_ENV: "production" marks the process as production without NODE_ENV (same startup guards apply).
# CIVIC_ENV=production
# CIVIC_ALLOW_DEMO: "1" lets a production start run on demo-provenance data in data/generated (staging only).
# CIVIC_ALLOW_DEMO=0
# CIVIC_GENERATED_DIR: where the generated datasets live. Default data/generated.
# CIVIC_GENERATED_DIR=data/generated
# SERVE_BUILT: "1" serves dist/ (no Vite) even when NODE_ENV is not production. Used by e2e/ops.spec.ts for a bundle smoke test.
# SERVE_BUILT=0

# --- HTTP hardening ---
# CORS_ORIGINS: comma-separated allowlist of cross-origin callers. Default none (same-origin only).
# CORS_ORIGINS=
# RATE_LIMIT_BURST: per-IP token bucket burst for /api/v1. Default 120.
# RATE_LIMIT_BURST=120
# RATE_LIMIT_PER_SEC: per-IP refill rate for /api/v1. Default 20.
# RATE_LIMIT_PER_SEC=20

# --- Observability (S-67) ---
# LOG_LEVEL: debug | info | warn | error. Default info. Logs are JSON lines with a request id; phone/OTP/PIN/token values are redacted.
# LOG_LEVEL=info
# METRICS_TOKEN: when set, GET /metrics requires "Authorization: Bearer <token>". When unset, /metrics answers loopback connections only.
# METRICS_TOKEN=

# --- Jobs and migrations ---
# CIVIC_JOBS: "0" disables the job scheduler (retention, erasure, anchoring, chain verification). Default enabled.
# CIVIC_JOBS=1
# CIVIC_ALLOW_DRIFT: "1" lets the server start although an applied migration's SQL changed (S-72). Emergency use only; never leave set.
# CIVIC_ALLOW_DRIFT=0
# CIVIC_PREMIGRATE_BACKUP: "0" disables the automatic copy taken before pending migrations run. Default enabled.
# CIVIC_PREMIGRATE_BACKUP=1

# --- Backups (S-68) ---
# CIVIC_BACKUP_KEY: 32-byte AES-256-GCM key as 64 hex chars or base64 (openssl rand -hex 32). REQUIRED in production. Escrow it (docs/RUNBOOK.md).
# CIVIC_BACKUP_KEY=
# CIVIC_BACKUP_DIR: where scripts/backup.ts writes. Default data/backups.
# CIVIC_BACKUP_DIR=data/backups
# CIVIC_BACKUP_KEEP: encrypted backups to keep (rotation). Default 14.
# CIVIC_BACKUP_KEEP=14

# --- IVR / missed-call webhook authentication ---
# CIVIC_IVR_WEBHOOK_SECRET: shared secret that signs/authenticates telephony-provider webhooks. Required in production.
# CIVIC_IVR_WEBHOOK_SECRET=
# CIVIC_IVR_ALLOWED_IPS: comma-separated provider IPs allowed to call the webhooks.
# CIVIC_IVR_ALLOWED_IPS=

# --- Data pipeline (npm run pipeline:*) ---
# TCPD_CSV_URL: override the TCPD election CSV source URL.
# TCPD_CSV_URL=
# TCPD_ELECTION_TYPE: election type filter for the TCPD import (e.g. AE, GE).
# TCPD_ELECTION_TYPE=
# BOUNDARIES_AP_URL: override the Andhra Pradesh boundary source URL.
# BOUNDARIES_AP_URL=
# BOUNDARIES_TG_URL: override the Telangana boundary source URL.
# BOUNDARIES_TG_URL=
# DATA_GOV_IN_API_KEY: data.gov.in API key for the census fetch (never commit a real key).
# DATA_GOV_IN_API_KEY=
# DATA_GOV_IN_RESOURCE_ID: data.gov.in resource id for the census dataset.
# DATA_GOV_IN_RESOURCE_ID=
# CENSUS_RAW_DIR: directory of manually downloaded census files read by pipeline:census. Default data/raw/census.
# CENSUS_RAW_DIR=data/raw/census

# --- Dev tooling ---
# DISABLE_HMR: "true" turns off Vite HMR (used by some hosted preview environments).
# DISABLE_HMR=false

# --- People pages (server/people-api.ts) ---
# PEOPLE_BLACKOUT: "1" hides photos and leader lists and shows a neutral notice (election-period neutrality). Default off.
# PEOPLE_BLACKOUT=0
# PEOPLE_REQUEST_BURST: max correction/takedown requests per address per 10 minutes (default 3 in production, 30 otherwise).
# PEOPLE_REQUEST_BURST=3
# PEOPLE_SLA_DAYS: days within which a correction/takedown request is reviewed. Default 7.
# PEOPLE_SLA_DAYS=7

# --- Civic hardening, issues, media and admin (Wave 4) ---
# CIVIC_ANCHOR_URL / CIVIC_ANCHOR_SECRET: HTTP witness for the audit-chain head (POSTed with an HMAC signature). Unset = local file anchor only.
# CIVIC_ANCHOR_URL=
# CIVIC_ANCHOR_SECRET=
# CIVIC_EDGE_SECRET: shared secret the trusted edge sends in X-Civic-Edge; CIVIC_TRUSTED_EDGE_IPS: comma list of edge addresses.
# CIVIC_EDGE_SECRET=
# CIVIC_TRUSTED_EDGE_IPS=
# CIVIC_UNVERIFIED_CAP_FACTOR: weight applied to caps for unattested clients (default 1).
# CIVIC_UNVERIFIED_CAP_FACTOR=1
# CIVIC_EXPORT_MAX_ROWS (default 10000) / CIVIC_EXPORT_PER_HOUR (default 20): open-data export limits.
# CIVIC_EXPORT_MAX_ROWS=10000
# CIVIC_EXPORT_PER_HOUR=20
# CIVIC_GPS_EXACT_DAYS: days the exact (encrypted) GPS point is kept (default 30).
# CIVIC_GPS_EXACT_DAYS=30
# CIVIC_INVITE_DAILY_CAP (10), CIVIC_INVITE_TARGET_DAILY_CAP (3), CIVIC_INVITE_COOLDOWN_DAYS (7), CIVIC_MAX_DEPENDENTS (8): household abuse caps.
# CIVIC_INVITE_DAILY_CAP=10
# CIVIC_INVITE_TARGET_DAILY_CAP=3
# CIVIC_INVITE_COOLDOWN_DAYS=7
# CIVIC_MAX_DEPENDENTS=8
# CIVIC_IVR_CALL_TTL_MS: IVR call state lifetime (default 900000). CIVIC_IVR_RECORDING_HOSTS: comma list of allowed aggregator recording hosts.
# CIVIC_IVR_CALL_TTL_MS=900000
# CIVIC_IVR_RECORDING_HOSTS=
# CIVIC_LEXICON_FILE: moderation lexicon path; CIVIC_LEXICON_ADD_APPROVALS (1) / CIVIC_LEXICON_RETIRE_APPROVALS (2): approvals needed.
# CIVIC_LEXICON_FILE=data/civic/moderation-lexicon.json
# CIVIC_LEXICON_ADD_APPROVALS=1
# CIVIC_LEXICON_RETIRE_APPROVALS=2
# CIVIC_LOGIN_SOURCE_LIMIT (per person+source) / CIVIC_LOGIN_PHONE_CEILING (per person across sources): login attempt limits.
# CIVIC_LOGIN_SOURCE_LIMIT=5
# CIVIC_LOGIN_PHONE_CEILING=20
# CIVIC_MEDIA_KEY: overrides the key provider for media at rest (production should use the key provider). CIVIC_MEDIA_SCANNER=none disables the heuristic scanner (dev only).
# CIVIC_MEDIA_KEY=
# CIVIC_MEDIA_SCANNER=heuristic
# CIVIC_PHOTO_MAX_DIM (6000) / CIVIC_PHOTO_MAX_PIXELS (25000000): photo dimension caps.
# CIVIC_PHOTO_MAX_DIM=6000
# CIVIC_PHOTO_MAX_PIXELS=25000000
# CIVIC_RECHECK_FRACTION: share of volunteer enrolments sampled for re-check (default 0.1).
# CIVIC_RECHECK_FRACTION=0.1
# CIVIC_SCRYPT_CONCURRENCY: parallel PIN hashes (default 4).
# CIVIC_SCRYPT_CONCURRENCY=4
# CIVIC_SESSION_TTL_DAYS (7) / CIVIC_SESSION_MAX_DAYS (30): sliding session lifetime and hard cap.
# CIVIC_SESSION_TTL_DAYS=7
# CIVIC_SESSION_MAX_DAYS=30
# CIVIC_TOTP_WINDOW: accepted TOTP step drift (default 1).
# CIVIC_TOTP_WINDOW=1
# TEST_WORKER_INDEX: set by the test runner only.
# TEST_WORKER_INDEX=

# CIVIC_OTP_IP_LIMIT: OTP requests allowed per IP per 10 minutes (default 10). Tests raise it; keep the default in production.
# CIVIC_OTP_IP_LIMIT=10

# E2E_BUILT: "1" runs Playwright against the production bundle (npm run build first); used for the offline-shell and 2G specs.
# E2E_BUILT=0

# --- Providers (S-62 number intelligence, S-63 SMS, S-64 KMS/HSM). Neutral HTTP/JSON adapters; see docs/PROVIDERS.md. ---
# A vendor-specific adapter module can instead call setKeyProvider / setSmsProvider / setNumberIntelligence itself; those win over these URLs.
# CIVIC_KMS_URL: base URL of a KMS speaking the neutral wrap/unwrap/hmac shape (https in production). Installs RemoteKmsKeyProvider.
# CIVIC_KMS_URL=
# CIVIC_KMS_SECRET: HMAC secret that signs requests to the KMS. Required with CIVIC_KMS_URL.
# CIVIC_KMS_SECRET=
# CIVIC_KMS_KEK_ID: id of the KMS key that wraps the per-purpose data keys. Required with CIVIC_KMS_URL.
# CIVIC_KMS_KEK_ID=
# CIVIC_KMS_RECOVERY_KEY_ID: KEK that dual-control break-glass bundles are wrapped under. Only needed to use break-glass export.
# CIVIC_KMS_RECOVERY_KEY_ID=
# CIVIC_KMS_TIMEOUT_MS: per-call KMS deadline. Default 3000.
# CIVIC_KMS_TIMEOUT_MS=3000
# CIVIC_KMS_CACHE_TTL_MS: how long an unwrapped data key may be used without a successful refresh before every operation fails closed. Default 900000 (15 min). 0 = never expire (not recommended).
# CIVIC_KMS_CACHE_TTL_MS=900000
# CIVIC_SMS_URL: neutral SMS submit endpoint (https in production). Installs HttpSmsProvider.
# CIVIC_SMS_URL=
# CIVIC_SMS_SECRET: HMAC secret that signs submissions to CIVIC_SMS_URL. Required with it.
# CIVIC_SMS_SECRET=
# CIVIC_SMS_RECEIPT_SECRET: HMAC secret that authenticates delivery receipts POSTed to /api/v1/civic/channels/sms-receipt. Required in production with CIVIC_SMS_URL.
# CIVIC_SMS_RECEIPT_SECRET=
# CIVIC_SMS_RECEIPT_URL: public URL of the receipt endpoint, passed to the vendor as callback_url.
# CIVIC_SMS_RECEIPT_URL=
# CIVIC_SMS_TEMPLATES_FILE: JSON array of DLT templates ({id, dltTemplateId, body, language, category, senderId?}) merged over the built-in ones. Production refuses any text that is not a template carrying a dltTemplateId.
# CIVIC_SMS_TEMPLATES_FILE=
# CIVIC_SMS_SENDER_ID: default DLT sender id (header) for templates that do not set one.
# CIVIC_SMS_SENDER_ID=
# CIVIC_SMS_TIMEOUT_MS: per-attempt vendor deadline; a send never blocks a request longer than this. Default 4000.
# CIVIC_SMS_TIMEOUT_MS=4000
# CIVIC_SMS_MAX_ATTEMPTS: attempts before a message is dead-lettered. Default 5.
# CIVIC_SMS_MAX_ATTEMPTS=5
# CIVIC_SMS_UNIT_COST: price per SMS segment in CIVIC_SMS_CURRENCY. Unset = unknown: costs are recorded as 0 and flagged, never silently free.
# CIVIC_SMS_UNIT_COST=
# CIVIC_SMS_CURRENCY: currency of CIVIC_SMS_UNIT_COST. Default INR.
# CIVIC_SMS_CURRENCY=INR
# CIVIC_SMS_DAILY_COST_CAP: known spend per rolling 24 h above which further sends are held (state budget_exhausted). Unset = no cap.
# CIVIC_SMS_DAILY_COST_CAP=
# CIVIC_NUMINTEL_URL: neutral number-intelligence endpoint (https in production; the clear number is sent). Installs HttpNumberIntel.
# CIVIC_NUMINTEL_URL=
# CIVIC_NUMINTEL_SECRET: HMAC secret that signs lookups. Required with CIVIC_NUMINTEL_URL.
# CIVIC_NUMINTEL_SECRET=
# CIVIC_NUMINTEL_TIMEOUT_MS: lookup deadline; on timeout the result is "unknown, reduced trust" and sign-up continues. Default 2000.
# CIVIC_NUMINTEL_TIMEOUT_MS=2000
# CIVIC_NUMINTEL_CACHE_TTL_MS: how long a verdict is cached by phone hash. Default 86400000 (24 h).
# CIVIC_NUMINTEL_CACHE_TTL_MS=86400000
# CIVIC_ALLOW_NO_ATTESTATION: "1" lets a production start run on the dev attestation verifier (device ids then only come from the trusted edge). Explicit risk acceptance.
# CIVIC_ALLOW_NO_ATTESTATION=0
