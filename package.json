{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/backup.ts scripts/restore-drill.ts --bundle --platform=node --format=cjs --packages=external --out-extension:.js=.cjs --outdir=dist/scripts",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "pipeline:elections": "tsx scripts/fetch-elections.ts",
    "pipeline:census": "tsx scripts/fetch-census.ts",
    "pipeline:lgd": "tsx scripts/fetch-lgd.ts",
    "pipeline:boundaries": "tsx scripts/fetch-boundaries.ts",
    "pipeline:names-te": "tsx scripts/fetch-names-te.ts",
    "pipeline:mandals": "tsx scripts/fetch-mandals.ts",
    "pipeline:villages": "tsx scripts/fetch-village-points.ts",
    "pipeline:shrug": "tsx scripts/ingest-shrug.ts",
    "refresh:data": "tsx scripts/refresh-data.ts",
    "geo:version:check": "tsx scripts/geo-version-check.ts",
    "import:lgd": "tsx scripts/import-lgd.ts",
    "pipeline:lsmap": "tsx pipeline/lsmap/build.ts",
    "history:build": "tsx scripts/history-build.ts",
    "pipeline:history": "tsx scripts/build-history.ts",
    "pipeline:validate": "tsx scripts/validate-data.ts",
    "pipeline:manifest": "tsx scripts/build-manifest.ts",
    "pipeline:attribution": "tsx scripts/gen-attribution.ts",
    "pipeline:census:dchb": "tsx scripts/ingest-dchb-census.ts",
    "pipeline:all": "npm run pipeline:elections && npm run pipeline:census && npm run pipeline:lgd && npm run pipeline:boundaries && npm run pipeline:manifest && npm run pipeline:validate",
    "test:pipeline": "vitest run tests/pipeline",
    "test:api": "vitest run tests/api tests/lib",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:poll-watch": "playwright test e2e/broadcast-poll.journey.spec.ts e2e/broadcast-poll.spec.ts --project=chromium --workers=1 --headed",
    "e2e:poll-videos": "playwright test e2e/broadcast-poll.journey.spec.ts --project=chromium --workers=1",
    "tracker": "tsx scripts/gen-tracker.ts",
    "tracker:html": "node scripts/tracker-html.cjs",
    "ci": "npm run lint && npm run lint:eslint && npm run check:docs && npm run test:coverage && npm run build && npm run test:e2e && npm run tracker -- --check",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "scan:secrets": "tsx scripts/check-secrets.ts",
    "scan:pii": "tsx scripts/scan-pii.ts",
    "test:tooling": "vitest run tests/tooling",
    "test:ops": "vitest run tests/ops tests/tracker",
    "test:coverage": "vitest run --coverage",
    "lint:eslint": "eslint .",
    "check:docs": "tsx scripts/check-docs.ts",
    "load:otp": "tsx scripts/load/otp-flood.ts",
    "load:count": "tsx scripts/load/count-day.ts",
    "load:countday": "tsx scripts/load/countday.ts",
    "countday:ingest": "tsx scripts/countday-ingest.ts",
    "countday:publish": "tsx scripts/countday-publish.ts",
    "countday:verify": "tsx scripts/countday-verify.ts",
    "test:e2e:built": "E2E_BUILT=1 playwright test e2e/lite.spec.ts --project=chromium -g \"offline|first usable\"",
    "measure:lite": "E2E_BUILT=1 playwright test e2e/lite.spec.ts --project=chromium --grep @measure",
    "backup": "tsx scripts/backup.ts",
    "restore-drill": "tsx scripts/restore-drill.ts",
    "gate:status": "tsx scripts/gate-status.ts",
    "pilot:skew": "tsx scripts/pilot-skew.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autocannon": "^9.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3",
    "polygon-clipping": "^0.15.7",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.2.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
