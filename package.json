{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "pipeline:elections": "tsx scripts/fetch-elections.ts",
    "pipeline:census": "tsx scripts/fetch-census.ts",
    "pipeline:boundaries": "tsx scripts/fetch-boundaries.ts",
    "pipeline:validate": "tsx scripts/validate-data.ts",
    "pipeline:all": "npm run pipeline:elections && npm run pipeline:census && npm run pipeline:boundaries && npm run pipeline:validate",
    "test:pipeline": "vitest run tests/pipeline",
    "test:api": "vitest run tests/api tests/lib",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tracker": "tsx scripts/gen-tracker.ts",
    "ci": "npm run lint && npm test && npm run tracker -- --check && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.1"
  }
}
